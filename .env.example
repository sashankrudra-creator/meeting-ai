# Copy this file to `.env` and adjust for your environment.
# Every value here has a sensible default in app/config.py; only set what
# you need to override.

# ---- General ----
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

# ---- Storage ----
DATA_DIR=data
DATABASE_PATH=data/mom_pipeline.db

# ---- Upload validation ----
MAX_UPLOAD_SIZE_MB=2048

# ---- FFmpeg ----
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# ---- Speech recognition (faster-whisper) ----
# Use a smaller model on CPU-only / low-RAM machines, e.g. "small" or "base".
WHISPER_MODEL_NAME=large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
# Leave WHISPER_LANGUAGE unset for automatic language detection (required
# for multilingual/code-switched meetings). Only set it to force one language.
# WHISPER_LANGUAGE=en
WHISPER_VAD_FILTER=true
WHISPER_SEGMENT_LEVEL_LANGUAGE_DETECTION=false

# ---- Speaker diarization (pyannote) ----
# pyannote/speaker-diarization-community-1 is GATED on Hugging Face:
# 1. Accept its license at https://huggingface.co/pyannote/speaker-diarization-community-1
# 2. Create an access token at https://huggingface.co/settings/tokens
# 3. Set it below (or export HUGGINGFACE_TOKEN in your shell).
DIARIZATION_MODEL_NAME=pyannote/speaker-diarization-community-1
DIARIZATION_DEVICE=cpu
HUGGINGFACE_TOKEN=

# pyannote.audio 4.x decodes audio via TorchCodec (not torchaudio/soundfile),
# which on WINDOWS needs a *shared* FFmpeg build's DLLs (avutil-*.dll,
# avcodec-*.dll, avformat-*.dll, swresample-*.dll, swscale-*.dll) to be
# discoverable via os.add_dll_directory(). A typical "full_build" FFmpeg
# install (e.g. Gyan.dev's default build, including what `winget install
# Gyan.FFmpeg` gives you) is STATIC and ships none of these DLLs, causing
# diarization to fail with "Could not load libtorchcodec_core*.dll (or one
# of its dependencies)" no matter what directory you add to PATH.
# If you hit that error: download a *shared* FFmpeg build (e.g.
# https://github.com/GyanD/codexffmpeg/releases — the "...-full_build-shared"
# asset) and point this at its bin/ folder (the one containing avutil-*.dll
# etc.) — this is separate from FFMPEG_BINARY/FFPROBE_BINARY above, which can
# keep pointing at your existing ffmpeg.exe for audio preprocessing. Ignored
# on Linux/macOS.
# FFMPEG_SHARED_DLL_DIR=E:\ffmpeg-shared\ffmpeg-8.1.2-full_build-shared\bin

# ---- Local summarization / MoM ----
# "local_llm" is the spec-compliant production backend; "extractive" is a
# zero-download, rule-based fallback useful for offline smoke tests / CI.
SUMMARIZER_BACKEND=local_llm
SUMMARIZER_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct
SUMMARIZER_DEVICE=cpu

# ---- Background processing ----
MAX_CONCURRENT_JOBS=1
